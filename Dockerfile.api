FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props ./
COPY src/DongNamTrip.Contracts/DongNamTrip.Contracts.csproj src/DongNamTrip.Contracts/
COPY src/DongNamTrip.Api/DongNamTrip.Api.csproj src/DongNamTrip.Api/
RUN dotnet restore src/DongNamTrip.Api/DongNamTrip.Api.csproj
COPY src/DongNamTrip.Contracts/ src/DongNamTrip.Contracts/
COPY src/DongNamTrip.Api/ src/DongNamTrip.Api/
RUN dotnet publish src/DongNamTrip.Api/DongNamTrip.Api.csproj -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "DongNamTrip.Api.dll"]
