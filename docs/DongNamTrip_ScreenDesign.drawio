/mxCell><mxCell id="c28" value="12" style="endArrow=open;endSize=10;html=1;strokeColor=#2F5597;strokeWidth=1.3;fontColor=#C00000;fontStyle=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="13" style="endArrow=open;endSize=10;html=1;strokeColor=#2F5597;strokeWidth=1.3;fontColor=#C00000;fontStyle=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="1: Nhấn [Đăng nhập] trên đầu trang, hoặc mở trang cần đăng nhập khi chưa đăng nhập&lt;br&gt;2: Nhấn liên kết [Đăng ký] / [Đăng nhập] giữa hai màn hình&lt;br&gt;3: Nhấn [Khám phá tour] hoặc [Tìm]&lt;br&gt;4: Nhấn một thẻ tour&lt;br&gt;5: Nhấn [Điểm đến]&lt;br&gt;6: Nhấn một thẻ địa điểm (thẻ địa điểm ở Trang chủ cũng mở SCR07)&lt;br&gt;7: Nhấn [Tự tạo chuyến đi], [Tùy chỉnh lịch trình] hoặc [Thêm vào lịch trình]&lt;br&gt;8: Nhấn [Chuyến đi của tôi]&lt;br&gt;9: Nhấn [Xem] một đơn hoặc một yêu cầu&lt;br&gt;10: Nhấn [Gửi yêu cầu tour riêng]&lt;br&gt;11: Xác nhận đặt tour thành công (mở chi tiết đơn mới)&lt;br&gt;12: Nhấn [Nghe thuyết minh] (đơn Đã xác nhận) hoặc quét mã QR tại điểm&lt;br&gt;13: Nhấn [Mở để sửa] một lịch trình đã lưu&lt;br&gt;Mũi tên hai chiều: quay lại bằng logo DongNamTrip / thanh điều hướng (mọi màn hình đều về được SCR01)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20.0" y="690.0" width="1100.0" height="308.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Sơ đồ chuyển màn hình WinForms" id="Sơ đồ chuyển màn hình WinForms"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxC