# Copy to .env (git-ignored). Avoid ';' and '=' in the password: it is embedded in a connection string.
# Must satisfy SQL Server policy: 8+ chars, upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!

# Optional Development-only first admin (created only if the email does not exist).
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
