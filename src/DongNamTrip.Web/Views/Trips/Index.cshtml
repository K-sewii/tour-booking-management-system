@model TripsVm
@{ ViewData["Title"] = "Chuyến đi của tôi"; }
<section class="page-intro"><div class="container">
<div class="eyebrow">CHÀO @User.Identity?.Name</div>
<h1>Những chuyến đi đang chờ.</h1>
<p>Tiếp tục lịch trình, gửi yêu cầu tour riêng và xem báo giá của bạn.</p>
</div></section>
<div class="container section">
@if (TempData["TripNotice"] is string notice) { <p class="notice" role="status">@notice</p> }
@if (TempData["TripError"] is string error) { <p class="validation" role="alert">@error</p> }
<div class="tabs" role="tablist">
<button id="drafts-tab" class="current" data-tab="drafts" role="tab" aria-selected="true" aria-controls="drafts">Lịch trình nháp (@Model.Itineraries.Count)</button>
<button id="bookings-tab" data-tab="bookings" role="tab" aria-selected="false" aria-controls="bookings">Tour đã đặt (@Model.Orders.Count)</button>
<button id="quotes-tab" data-tab="quotes" role="tab" aria-selected="false" aria-controls="quotes">Yêu cầu &amp; báo giá (@Model.Requests.Count)</button>
</div>
<section id="drafts" role="tabpanel" aria-labelledby="drafts-tab">
@if (Model.Itineraries.Count == 0) { <div class="empty"><h2>Bắt đầu chuyến đi tiếp theo ở đây.</h2><p>Bạn chưa lưu lịch trình nào.</p><a class="btn" href="/Planner">Tạo lịch trình</a></div> }
else { <div class="card-grid">@foreach (var trip in Model.Itineraries) { <article class="saved-trip">
<span class="pill">Lịch trình nháp #@trip.Id</span><h2>@trip.Name</h2>
<p>@trip.StartDate.ToString("dd/MM/yyyy") · @trip.Guests khách</p>
<ol>@foreach (var id in trip.DestinationIds) { <li>@Model.Destinations.FirstOrDefault(x => x.Id == id)?.Name</li> }</ol>
@foreach (var warning in trip.Warnings) { <p class="hint">⚠ @warning</p> }
<p><a class="text-link" asp-controller="Planner" asp-action="Index" asp-route-itineraryId="@trip.Id">Mở và sửa lịch trình →</a></p>
<form asp-controller="Trips" asp-action="RequestQuote" method="post">
<input type="hidden" name="itineraryId" value="@trip.Id"/>
<label>Thông tin liên hệ<input name="Contact" required maxlength="250" value="@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value"/></label>
<label>Nhu cầu dịch vụ<textarea name="ServiceNeeds" maxlength="2000" rows="2" placeholder="Điểm đón, bữa ăn, hướng dẫn viên…"></textarea></label>
<button class="btn small" type="submit">Gửi yêu cầu báo giá</button>
</form><small>Lưu kế hoạch không tạo đơn hoặc giữ chỗ.</small>
</article> }</div> }
</section>
<section id="bookings" role="tabpanel" aria-labelledby="bookings-tab" hidden>
@if (Model.Orders.Count == 0) { <div class="empty"><h2>Chưa có tour đã đặt.</h2><p>Đơn tour riêng được tạo khi bạn chấp nhận báo giá còn hiệu lực.</p></div> }
else { <div class="card-grid">@foreach (var order in Model.Orders) { <article class="saved-trip"><span class="pill">Đơn #@order.Id</span><h2>Tour riêng</h2><p>@order.Guests khách · @order.AgreedPrice.ToString("N0") ₫</p><p>Trạng thái: @order.Status · Báo giá #@order.QuoteId</p><small>Điều kiện hủy: @order.CancellationTerms</small></article> }</div> }
</section>
<section id="quotes" role="tabpanel" aria-labelledby="quotes-tab" hidden>
@if (Model.Requests.Count == 0) { <div class="empty"><h2>Chưa có yêu cầu tour riêng.</h2><p>Gửi kế hoạch đã lưu để nhân viên xác minh và lập báo giá.</p></div> }
else { <div class="card-grid">@foreach (var request in Model.Requests) { <article class="saved-trip">
<span class="pill">Yêu cầu #@request.Id · Phiên bản @request.Version</span><h2>@request.Snapshot.Name</h2>
<p>@request.Snapshot.StartDate.ToString("dd/MM/yyyy") · @request.Snapshot.Guests khách · @request.Status</p>
<p>Liên hệ: @request.Contact</p>
<ol>@foreach (var stop in request.Snapshot.Stops) { <li>Ngày @stop.Day: @Model.Destinations.FirstOrDefault(x => x.Id == stop.DestinationId)?.Name</li> }</ol>
@foreach (var quote in request.Quotes.OrderByDescending(x => x.Id)) { <div class="quote-summary">
<b>Báo giá #@quote.Id · @quote.Status</b><p>Tổng: @quote.Total.ToString("N0") ₫ · Cần thu: @quote.AmountDue.ToString("N0") ₫</p>
<p>Hiệu lực đến @quote.ExpiresAt.ToString("dd/MM/yyyy HH:mm") · Điều kiện hủy: @quote.CancellationTerms</p>
<ul>@foreach (var line in quote.Lines) { <li>@line.Description: @line.Quantity @line.Unit × @line.UnitPrice.ToString("N0") ₫</li> }</ul>
@if (quote.Status == "Issued" && quote.ExpiresAt > DateTime.UtcNow) { <form asp-controller="Trips" asp-action="AcceptQuote" method="post"><input type="hidden" name="requestId" value="@request.Id"/><input type="hidden" name="quoteId" value="@quote.Id"/><button class="btn small" type="submit">Chấp nhận báo giá</button></form> }
</div> }
</article> }</div> }
</section>
</div>
