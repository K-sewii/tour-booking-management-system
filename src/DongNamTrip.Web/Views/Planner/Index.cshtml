@model PlannerVm
@{ ViewData["Title"] = "Tự tạo chuyến đi"; }
<section class="page-intro compact">
<div class="container">
<div class="eyebrow">LÊN Ý TƯỞNG, RỒI LÊN ĐƯỜNG</div>
<h1>Chuyến đi của riêng bạn.</h1>
<p>Chọn điểm đến, hoạt động mong muốn và lưu hành trình để nhận tư vấn.</p></div></section>
<div class="container section" id="planner" data-initial="@System.Text.Json.JsonSerializer.Serialize(Model.InitialStops)" data-existing-id="@Model.Existing?.Id" data-authenticated="@(User.Identity?.IsAuthenticated==true ? "true" : "false")">
<div class="planner-steps"><b>01 Chọn điểm đến</b>
<span>→</span><b>02 Sắp xếp lịch trình</b>
<span>→</span><b>03 Lưu ý tưởng</b></div>
<div class="planner-layout">
<section>
<div class="section-heading">
<h2>Thêm nơi bạn muốn đến</h2>
<label class="sr-only" for="place-search">Tìm địa điểm</label>
<input id="place-search" placeholder="Tìm tên hoặc khu vực…"/></div>
<div id="place-list">@foreach(var d in Model.Catalog.Destinations){<article class="place-row" data-id="@d.Id" data-name="@d.Name" data-region="@d.Region" data-minutes="@d.VisitMinutes">
<img src="~/images/@(d.Illustration).svg" alt=""/>
<div><small>@d.Region · @d.VisitMinutes phút</small>
<h3>@d.Name</h3>
<span>@d.Category</span></div>
<button type="button" class="add-place" aria-label="Thêm @d.Name">+</button></article>}<p id="no-places" hidden>Không có địa điểm phù hợp với từ khóa.</p></div></section>
<div id="planner-options" hidden>
@foreach (var activity in Model.Catalog.Activities) { <span class="planner-activity" data-id="@activity.Id" data-destination="@activity.DestinationId" data-name="@activity.Name" data-duration="@activity.DurationMinutes" data-fee="@activity.ReferenceFee"></span> }
@foreach (var slot in Model.Catalog.Slots) { <span class="planner-slot" data-id="@slot.Id" data-activity="@slot.ActivityId" data-destination="@slot.DestinationId" data-date="@slot.Date.ToString("yyyy-MM-dd")" data-start="@slot.StartsAt.ToString("HH:mm")" data-end="@slot.EndsAt.ToString("HH:mm")" data-status="@slot.Status"></span> }
</div>
<aside class="itinerary-panel">
<div class="section-heading">
<h2>Lịch trình của bạn</h2>
<span class="pill" id="selected-count">0 điểm</span></div>
<form id="itinerary-form" asp-controller="Planner" asp-action="Save" method="post">
@if (Model.Existing is not null) { <input type="hidden" name="itineraryId" value="@Model.Existing.Id"/> }
<label>Tên chuyến đi<input name="Name" required maxlength="100" value="@Model.Existing?.Name" placeholder="Cuối tuần đi đâu đó…"/></label>
<div class="form-row">
<label>Ngày dự kiến<input name="StartDate" type="date" required min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(Model.Existing?.StartDate.ToString("yyyy-MM-dd") ?? DateTime.Today.AddDays(7).ToString("yyyy-MM-dd"))"/></label>
<label>Số khách<input name="Guests" type="number" min="1" max="40" value="@(Model.Existing?.Guests ?? 2)" required/></label></div>
<div class="form-row">
<label>Nơi xuất phát<input name="DeparturePoint" maxlength="250" value="@Model.Existing?.DeparturePoint" placeholder="Ví dụ: TP. Hồ Chí Minh"/></label>
<label>Phương tiện<input name="Transport" maxlength="50" value="@Model.Existing?.Transport" placeholder="Ô tô, xe máy…"/></label></div>
<label>Ngân sách dự kiến (VNĐ)<input name="Budget" type="number" min="0" step="1" value="@Model.Existing?.Budget"/></label>
<ol id="selected-places"></ol>
<div class="planner-empty" id="planner-empty">
<span>↖</span><b>Bắt đầu từ một nơi bạn thích.</b>
<p>Nhấn dấu + để thêm điểm đầu tiên.</p></div>
<p class="hint" id="duration-note">Thời gian tham quan chưa bao gồm di chuyển.</p>
<p class="notice small-notice">Hoạt động và suất chỉ là mong muốn, chưa giữ chỗ. Thời gian di chuyển và khả năng cung ứng cần nhân viên xác minh.</p>
<button type="submit" class="btn full" id="save-itinerary">Lưu lịch trình ↗</button>
<p id="planner-message" role="status" aria-live="polite"></p>
<a class="text-link" id="planner-login" href="/Account/Login?returnUrl=%2FPlanner" hidden>Đăng nhập để lưu →</a>
<button type="button" class="reset-link" id="clear-itinerary">Làm mới lịch trình</button></form></aside></div></div>
@section Scripts {<script src="~/js/planner.js" asp-append-version="true" defer></script>}
